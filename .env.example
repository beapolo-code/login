# Secreto de sesion (cambialo por una cadena larga y aleatoria)
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Puerto del servidor
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Intentos fallidos antes de enviar la alerta de seguridad por email
MAX_FAILED_ATTEMPTS=5

# SMTP para alertas de seguridad (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu.email@gmail.com
SMTP_PASS=tu.contrasena_de_aplicacion_de_gmail
SMTP_FROM=tu.email@gmail.com

# Ruta opcional de la base SQLite (por defecto data/app.db)
# DB_PATH=./data/app.db
